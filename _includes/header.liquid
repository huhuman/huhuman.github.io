<header class="site-header">
  <div class="site-container header-inner">
    <a class="site-brand" href="{{ '/' | relative_url }}" aria-label="Shun-Hsiang Hsu — home"
      ><span class="brand-mark" aria-hidden="true">SH</span><span>Shun-Hsiang Hsu</span></a
    >
    <nav class="site-nav" aria-label="Main navigation">
      <a href="{{ '/#selected-work' | relative_url }}">Work</a>
      <a href="{{ '/#experience' | relative_url }}">Experience</a>
      <a
        href="{{ '/publications/' | relative_url }}"
        {% if page.url == '/publications/' %}
          aria-current="page"
        {% endif %}
        >Publications</a
      >
      <a
        href="{{ '/cv/' | relative_url }}"
        {% if page.url == '/cv/' %}
          aria-current="page"
        {% endif %}
        >Resume</a
      >
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" hidden><span aria-hidden="true">◐</span></button>
  </div>
</header>
