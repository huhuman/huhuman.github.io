---
---
<article class="publication-entry" id="{{ entry.key | escape }}">
  {% if entry.preview %}
    <div class="publication-visual">
      <img
        src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}"
        alt="Research illustration for {{ entry.title | strip_html | escape }}"
        loading="lazy"
        width="155"
        height="112"
      >
    </div>
  {% endif %}
  <div class="publication-body">
    <h3>{{ entry.title }}</h3>
    <p class="publication-authors">
      {% for author in entry.author_array -%}
        {%- unless forloop.first %}, {% endunless -%}
        {%- if author.last == 'Hsu' -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {{- author.first }}
          {{ author.last -}}
        {%- endif -%}
      {%- endfor %}
    </p>
    <p class="publication-venue">
      {% if entry.journal %}{{ entry.journal }}{% else %}{{ entry.booktitle }}{% endif %} · {{ entry.year }}
    </p>
    {% if entry.note %}
      <p class="publication-note">{{ entry.note }}</p>
    {% endif %}
    {% if entry.summary %}
      <p class="publication-summary">{{ entry.summary }}</p>
    {% endif %}
    {% if entry.contribution %}
      <p class="publication-contribution"><strong>Contribution:</strong> {{ entry.contribution }}</p>
    {% endif %}
    <div class="publication-links">
      {% if entry.doi -%}
        <a href="https://doi.org/{{ entry.doi }}">Paper <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.pdf -%}
        <a href="{{ entry.pdf }}">Paper (PDF) <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}">Code <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.website -%}
        <a href="{{ entry.website }}">Project <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.html -%}
        <a href="{{ entry.html }}">Read more <span aria-hidden="true">↗</span></a>
      {%- endif %}
    </div>
  </div>
</article>
