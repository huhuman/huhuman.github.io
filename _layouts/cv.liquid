---
layout: default
---
{% assign resume = site.data.resume %}
<article class="page-content">
  <header class="page-heading resume-header">
    <div>
      <p class="eyebrow">Shun-Hsiang Hsu / Resume</p>
      <h1>Research &amp; experience.</h1>
      <p class="page-lead">{{ resume.basics.summary | escape }}</p>
      <p>UIUC Ph.D. student · Expected 2027 · Champaign, Illinois</p>
    </div>
    <a class="button button-primary" href="{{ '/assets/pdf/Shun_Hsiang_Hsu_Resume.pdf' | relative_url }}">Resume (PDF) ↗</a>
  </header>
  <section class="resume-section" aria-labelledby="cv-experience">
    <h2 id="cv-experience">Professional experience</h2>
    {% for work in resume.work %}
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <div>
            <h3 class="company-heading">
              {{ work.name | escape }}
              {% if work.division %}
                <span class="company-unit">
                  {{- work.division | escape -}}
                  {%- if work.team %} · {{ work.team | escape }}{% endif -%}
                </span>
              {% endif %}
            </h3>
            <h4>{{ work.position | escape }}</h4>
          </div>
          <p class="resume-date">{{ work.startDate | escape }} – {{ work.endDate | default: 'present' | escape }}</p>
        </div>
        {% if work.summary %}
          <p>{{ work.summary | escape }}</p>
        {% endif %}
        <ul>
          {% for highlight in work.highlights %}
            <li>{{ highlight | escape }}</li>
          {% endfor %}
        </ul>
      </article>
    {% endfor %}
  </section>
  <section class="resume-section" aria-labelledby="cv-research">
    <h2 id="cv-research">Selected research</h2>
    {% for research in resume.research %}
      <article class="resume-entry">
        <h3>
          <a href="{{ research.url | relative_url }}">{{ research.name | escape }}</a>
        </h3>
        <p>{{ research.summary | escape }}</p>
        <ul>
          {% for highlight in research.highlights %}
            <li>{{ highlight | escape }}</li>
          {% endfor %}
        </ul>
      </article>
    {% endfor %}
    <a href="{{ '/publications/' | relative_url }}">Full publication list ↗</a>
  </section>
  <section class="resume-section" aria-labelledby="cv-projects">
    <h2 id="cv-projects">Engineering projects</h2>
    {% for project in resume.projects %}
      <article class="resume-entry">
        <h3>
          <a href="{{ project.url | relative_url }}">{{ project.name | escape }}</a>
        </h3>
        <p>{{ project.summary | escape }}</p>
        <ul>
          {% for highlight in project.highlights %}
            <li>{{ highlight | escape }}</li>
          {% endfor %}
        </ul>
      </article>
    {% endfor %}
  </section>
  <section class="resume-section" aria-labelledby="cv-education">
    <h2 id="cv-education">Education</h2>
    {% for education in resume.education %}
      <article class="resume-entry">
        <div class="resume-entry-heading">
          <div>
            <h3>{{ education.studyType | escape }}</h3>
            <h4>{{ education.area | escape }} · {{ education.institution | escape }}</h4>
          </div>
          <p class="resume-date">{{ education.startDate | escape }} – {{ education.endDate | default: 'present' | escape }}</p>
        </div>
        <p>GPA: {{ education.score | escape }}</p>
        {% if education.courses %}
          <ul>
            {% for item in education.courses %}
              <li>{{ item | escape }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </article>
    {% endfor %}
  </section>
  <section class="resume-section" aria-labelledby="cv-skills">
    <h2 id="cv-skills">Technical skills</h2>
    <dl class="resume-skills">
      {% for skill in resume.skills %}
        <div>
          <dt>{{ skill.name | escape }}</dt>
          <dd>{{ skill.keywords | join: ', ' | escape }}</dd>
        </div>
      {% endfor %}
    </dl>
  </section>
</article>
